# Corridor of Uncertainty — weekly update configuration.
#
# Install to ~/.config/corridor-of-uncertainty/cou.env and lock it down:
#
#   mkdir -p ~/.config/corridor-of-uncertainty
#   cp tools/cou.env.example ~/.config/corridor-of-uncertainty/cou.env
#   chmod 600 ~/.config/corridor-of-uncertainty/cou.env
#
# This file must NEVER be committed — it holds three separate secrets.

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# claude-opus-5 for best prose, claude-sonnet-5 for ~5x lower cost.
COU_MODEL=claude-opus-5

# --- YouTube --------------------------------------------------------------
# Data API v3 key, used to verify the RSS feed and to provide the full
# back-catalogue for --backfill. Create at console.cloud.google.com:
# enable "YouTube Data API v3", then Credentials -> Create -> API key.
# Restrict it to that one API. Cost: 1 quota unit per 50 videos.
YOUTUBE_API_KEY=

# Resolved automatically from the handle on first run and cached, but pinning
# it here removes a scrape and one more thing that can break.
# COU_CHANNEL_ID=UC...
COU_CHANNEL_HANDLE=CorridorOfUncertainty

# Optional: Netscape-format cookies.txt, exported while logged into YouTube.
# Only needed if yt-dlp starts returning "Sign in to confirm you're not a bot".
# COU_YOUTUBE_COOKIES=/home/you/secrets/youtube_cookies.txt

# --- Email notification (Gmail SMTP) --------------------------------------
# COU_SMTP_PASSWORD must be a Google *app password*, not the account password.
# Requires 2-Step Verification: myaccount.google.com -> Security -> App passwords.
COU_SMTP_HOST=smtp.gmail.com
COU_SMTP_PORT=587
COU_SMTP_USER=arees05@gmail.com
COU_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
COU_MAIL_TO=arees05@gmail.com

# --- WhatsApp notification (CallMeBot) ------------------------------------
# Same service as morning-briefing. Register at https://www.callmebot.com/
# WHATSAPP_PHONE / WHATSAPP_APIKEY are also accepted if already set on the host.
# COU_WHATSAPP_PHONE=+447700900123
# COU_WHATSAPP_APIKEY=123456

# --- Behaviour ------------------------------------------------------------
# Look-back window for a normal weekly run. 10 days (rather than 7) means a
# missed or failed run self-heals the following week instead of leaving a hole.
COU_WINDOW_DAYS=10

# Characters of transcript sent to the model. A 30-minute episode is roughly
# 30,000 characters, so the old 12,000 limit discarded over half of it.
COU_TRANSCRIPT_CHARS=120000
