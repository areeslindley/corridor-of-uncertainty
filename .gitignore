/.quarto/
**/*.quarto_ipynb

# Secrets — never commit. The real config lives at
# ~/.config/corridor-of-uncertainty/cou.env (mode 600); only the .example
# template belongs in the repository.
cou.env
*.env
!tools/cou.env.example

# YouTube cookie exports for yt-dlp
youtube_cookies.txt
yt_cookies.txt
*cookies*.txt

# Run logs from the weekly automation
/.logs/

# Superseded by tools/ — kept locally until you are happy to delete them.
/generate_episode.py
/generate_episode_2.py

# Audit artefacts (regenerated on demand)
youtube_episode_audit.csv
youtube_episode_audit_commands.sh

# Build output (GitHub Actions renders to gh-pages)
/_site/
/site_libs/

# Stray single-page HTML renders (source is .qmd)
/episodes/*.html

# Python
__pycache__/
*.py[cod]
/.venv/
/.pytest_cache/

.DS_Store
**/.DS_Store
